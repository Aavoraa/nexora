{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/b/:path*", "destination": "/api/index" },
    { "source": "/r/:path*", "destination": "/api/index" },
    { "source": "/l/:path*", "destination": "/api/index" },
    { "source": "/media-store/:path*", "destination": "/api/index" }
  ],
  "crons": [
    { "path": "/api/cron/tick", "schedule": "0 3 * * *" }
  ]
}
