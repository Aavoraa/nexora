{
  "name": "cadence",
  "version": "0.1.0",
  "description": "Cadence — plan, write, approve and schedule social posts as a team.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --env-file-if-exists=.env --watch server/index.js",
    "test": "node --env-file-if-exists=.env --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "lint": "eslint .",
    "check": "node scripts/check.js",
    "seed": "node --env-file-if-exists=.env scripts/seed.js",
    "icons": "node scripts/build-brand-icons.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "express": "^4.21.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "simple-icons": "^16.36.0"
  }
}
