# Copy to .env and fill in.

# PostgreSQL connection string. Create the database first, e.g.:
#   createdb -U postgres cadence
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/cadence

# Enables AI drafting in the composer. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional
PORT=3000
# Disposable database for `npm test` integration tests. It is WIPED on every run,
# and its name must contain "test".
# TEST_DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/cadence_test
# CADENCE_MODEL=claude-opus-5-5

# Password given to the demo accounts by `npm run seed` (demo_owner, demo_editor,
# demo_viewer). Development only; 8+ characters.
# SEED_PASSWORD=choose-a-demo-password

# Local media storage (development driver). Uploaded files live here.
# MEDIA_DIR=data/media
# Signs upload/view links. Set it so links survive restarts (any long random string).
# MEDIA_SIGNING_SECRET=

# Encrypts credentials saved on the Setup page. 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# TOKEN_ENCRYPTION_KEY=
